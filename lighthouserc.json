{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3211",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3211/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 5500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 1024000
          }
        ]
      },
      "aggregationMethod": "median"
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
