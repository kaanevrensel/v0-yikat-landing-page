# Disabled until API access, exact location identity and public-display rights are verified.
# Set only in the deployment secret manager; never use NEXT_PUBLIC_ for these values.
YIKAT_GOOGLE_REVIEWS_ENABLED=false
YIKAT_GOOGLE_REVIEWS_PUBLIC_DISPLAY_APPROVED=false
YIKAT_GOOGLE_OAUTH_CLIENT_ID=
YIKAT_GOOGLE_OAUTH_CLIENT_SECRET=
YIKAT_GOOGLE_OAUTH_REFRESH_TOKEN=
# API resource discovered after authorization, not a Maps CID or native UI profile ID.
YIKAT_GOOGLE_BUSINESS_LOCATION=
YIKAT_GOOGLE_BUSINESS_VERIFIED_PLACE_ID=
